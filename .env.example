# Copy to .env and fill in.
GCP_PROJECT=your-project-id
BQ_LOCATION=EU
# Optional: a Cloud Storage bucket for the landing zone (needs billing enabled).
# Leave empty to load straight into BigQuery (works in the free BigQuery sandbox).
GCS_BUCKET=
DATASET_PREFIX=volve
# Set to false in the free BigQuery sandbox: it expires partitions older than 60 days.
PARTITION_TABLES=true
